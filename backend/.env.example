# Leave DATABASE_URL unset on Render: the app builds a SQLite DB from cleaned_accidents.csv.
# DATABASE_URL=sqlite:///./saferoute.db

# OpenWeatherMap key (optional - app falls back to "Clear" without it)
OWM_API_KEY=your_openweathermap_api_key_here

# Comma-separated frontend URLs allowed by CORS (use * for local dev)
CORS_ORIGINS=http://localhost:5173
