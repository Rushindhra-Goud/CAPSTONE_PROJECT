{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/src/**,frontend/public/**,backend/retrain_compatible_model.py,backend/README.md,backend/API_CONTRACT_FOR_FRONTEND.md,**/tests/**,**/__tests__/**,**/examples/**,**/docs/**,**/__pycache__/**}"
    }
  }
}
